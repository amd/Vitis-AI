@@ -0,0 +1,77 @@
+import torch
+import cv2
+import numpy as np
+import os
+
+if (os.getenv('VAISW_INSTALL_DIR')):
+    import vaisw
+else:
+    vaisw = None
+
+class FrameSplitter:
+    def __init__(self, split_shape, scale, overlap=0, border=0, border_type='BORDER_REFLECT_101', border_value=None, split_lib='vaisw'):
+        self.split_shape = [ int(dim) for dim in split_shape.split('x') ]
+        self.scale = scale
+        self.overlap = overlap
+        self.border = border
+        self.border_type = eval("cv2." + border_type)
+        self.border_value = border_value
+        if vaisw:
+            self.split_lib = split_lib
+        else:
+            self.split_lib = 'numpy'
+        assert(self.border == self.overlap), 'Not supported: different values for overlap and border'
+        assert(self.split_lib in ['vaisw', 'numpy']), 'Not supported: the split library provided is not supported'
+
+        self.mipso_split_frame = self.vaisw_split_frame if self.split_lib == 'vaisw' else self.numpy_split_frame
+        self.mipso_merge_frames = self.vaisw_merge_frames if self.split_lib == 'vaisw' else self.numpy_merge_frames
+
+        self.out_shape = (None, None)
+
+    def vaisw_split_frame(self, frame):
+        image = np.ascontiguousarray(frame.numpy())
+        self.out_shape = (image.shape[2]*self.scale, image.shape[3]*self.scale)
+        snapshotImage = vaisw.splitNCHWImage(image, self.split_shape[1], self.split_shape[0], self.overlap)
+        return torch.as_tensor(snapshotImage)
+
+    def numpy_split_frame(self, frame):
+        frame = self.mipso_add_border(frame)
+        #Array that will contain the split image as batches
+        images = []
+        split_h = ( (frame.shape[2] + 2*(self.split_shape[1]-1)*self.overlap) + self.split_shape[1]-1) // self.split_shape[1]
+        split_hf = ( (frame.shape[2] + 2*(self.split_shape[1]-1)*self.overlap)) / self.split_shape[1]
+        split_w = ( (frame.shape[3] + 2*(self.split_shape[0]-1)*self.overlap) + self.split_shape[0]-1) // self.split_shape[0]
+        split_wf = ( (frame.shape[3] + 2*(self.split_shape[0]-1)*self.overlap)) / self.split_shape[0]
+        for iw in range(self.split_shape[0]):
+            pos_w = int(iw * (split_wf - 2*self.overlap))
+            end_w = pos_w + split_w
+            for ih in range(self.split_shape[1]):
+                pos_h = int(ih * (split_hf - 2*self.overlap))
+                end_h = pos_h + split_h
+                images.append(frame[:, :, pos_h:end_h, pos_w:end_w])
+        image_batch = np.concatenate( [*images] )
+        return torch.as_tensor(image_batch)
+
+    def vaisw_merge_frames(self, frames):
+        images = np.ascontiguousarray(frames.numpy())
+        vaisw_image = vaisw.mergeNCHWImages(images, *(self.out_shape), self.scale * self.overlap)
+        return torch.tensor(vaisw_image).unsqueeze(0)
+
+    def numpy_merge_frames(self, frames):
+        frames = frames.numpy()
+        rows = []
+        start_idx = 0
+        crop = self.overlap*self.scale
+        for i in range(self.split_shape[0]):
+            if crop:
+                rows.append( np.concatenate([ image[:, crop:-crop, crop:-crop] for idx, image in enumerate(frames) if idx in range(start_idx, start_idx + self.split_shape[1])], 1))
+            else:
+                rows.append( np.concatenate([ image for idx, image in enumerate(frames) if idx in range(start_idx, start_idx + self.split_shape[1])], 1))
+            start_idx += self.split_shape[1]
+        result = torch.tensor(np.concatenate(rows, 2)).unsqueeze(0)
+        return result
+
+    def mipso_add_border(self, frame):
+        frame = frame[0].permute(2, 1, 0).numpy()
+        frame = cv2.copyMakeBorder(frame, self.border, self.border, self.border, self.border, self.border_type, self.border_value)
+        return np.expand_dims(np.transpose(frame, (2, 1, 0)), axis=0)
