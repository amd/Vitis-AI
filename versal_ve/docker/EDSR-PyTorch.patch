diff --git a/run_image_dir b/run_image_dir
new file mode 100755
index 0000000000000000000000000000000000000000..1e4a66d772e0f8a25741469d017c5cce6d2ad259
--- /dev/null
+++ b/run_image_dir
@@ -0,0 +1,71 @@
+#! /bin/bash
+
+
+cat <<EOF
+Usage $0 img_dir_src img_dir_dst [scale]
+
+apply EDSR for all images of img_dir_src and write results in directory img_dir_dst
+if image already exists, EDSR computation is not redone
+
+scale is 2 by default
+
+EOF
+
+
+src=$1
+dst=$2
+scale=$3
+
+[ "$scale" = "" ] && scale=2
+
+EDSR_INPUT_DIR=INPUT
+EDSR_OUTPUT_DIR=experiment/test/results-Demo
+
+rm -rf   $EDSR_INPUT_DIR $EDSR_OUTPUT_DIR
+mkdir -p $EDSR_INPUT_DIR $EDSR_OUTPUT_DIR
+
+
+resize="$(( 100 / $scale ))%"
+
+
+mkdir -p $dst
+file_list=$( ls $src )
+# remove already computed files
+for f in $( ls $dst | sed 's/_x._SR//g' )
+do
+  file_list=$( echo "$file_list" | grep -v "^$f$" )
+done
+
+while [ "$file_list" != "" ]
+do
+  res=""
+
+  for f in $( echo "$file_list" )
+  do
+    cur=$( identify -format "%wx%h" "$src/$f" )
+    [ "$res" = "" ] && res=$cur
+    [ "$res" != "$cur" ] && echo "Skip file $f it has a $cur, different resolution than $res" && continue
+
+    # we will process $f
+    convert "$src/$f" -resize $resize "$EDSR_INPUT_DIR/$f"
+  done
+
+  echo "Processing EDSR for input resolution $res: $( ls $EDSR_INPUT_DIR )"
+  cd src
+  ./run ../$EDSR_INPUT_DIR --data_test Demo --scale $scale || exit 1
+  cd ..
+
+  # remove already computed files
+  for f in $( ls $EDSR_OUTPUT_DIR | sed 's/_x._SR//g' )
+  do
+    file_list=$( echo "$file_list" | grep -v "^$f$" )
+  done
+  mv $EDSR_OUTPUT_DIR/* $dst
+  rm -f $EDSR_INPUT_DIR/*
+done
+
+for f in $( ls $src )
+do
+  e="$( ls $dst/${f/./_x?_SR.} )"
+  echo "$( compare -metric PSNR $src/$f $e /dev/null ) : PSNR between $src/$f and $e"
+done
