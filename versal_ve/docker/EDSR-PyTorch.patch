diff --git a/src/run_snapshot b/src/run_snapshot
new file mode 100755
index 0000000000000000000000000000000000000000..0f9a117ac7a9185f7addda781d7512019c445689
--- /dev/null
+++ b/src/run_snapshot
@@ -0,0 +1,50 @@
+#! /bin/bash
+
+
+echo "Running ./run $@ with different snapshot mode"
+
+cmd=$1
+[ "$cmd" != "./run" ] && echo "ERROR in cmd $@" && exit 1
+shift
+
+# create a single directory image for snapshot creation
+inputDir=$1
+shift
+
+arg="$@"
+
+if [ -d "$inputDir" ]
+then
+  tmp=$( mktemp -d )
+  mkdir -p $tmp
+  cp $( ls $inputDir/* | head -n 1 ) $tmp
+
+  inputRun=$tmp
+else
+  tmp=""
+  inputRun=$inputDir
+fi
+
+vaisw_config --unset snapshot.mode
+
+# first make sure quantisation is ready
+./run $inputRun $arg || exit 1
+
+
+# enable snapshot mode
+vaisw_config --add snapshot.mode=txt
+
+./run $inputRun $arg || exit 1
+
+[ "$tmp" != "" ] && rm -rf $tmp
+
+vaisw_config --unset snapshot.mode
+
+./run $inputDir $arg --snapshot || exit 1
+
+echo "OK: running with snapshot mode"
+
+./run $inputDir $arg --snapshot_pipeline || exit 1
+
+echo "OK: running with pipeline mode"
+
