diff --git a/generate_embedded_snapshot b/generate_embedded_snapshot
new file mode 100755
index 0000000000000000000000000000000000000000..cc4966775e4e3491e8f6ac5aae0fe974f28b8860
--- /dev/null
+++ b/generate_embedded_snapshot
@@ -0,0 +1,35 @@
+#! /bin/bash
+
+cat <<EOF
+Generating YoloV2 snapshot for Vaisw Embedded SW stack.
+
+Usage:
+ $0                 # generate snapshot for YoloV2 for current (PCIe) board
+ $0 tiny            # generate snapshot for tiny-YoloV2 for current (PCIe) board
+ $0 0xc56679c0      # generate snapshot for YoloV2 for bitstream 0xc56679c0
+ $0 tiny 0xc56679c0 # generate snapshot for tiny-YoloV2 for bitstream 0xc56679c0
+
+EOF
+
+
+tiny=
+[ "$1" = "tiny" ] && tiny="tiny" && shift
+
+echo "Dumping a snapshot for Vaisw embedded stack for $tiny YoloV2"
+
+export VAISW_QUANTIZATION_MINIMALBATCHSIZE=1
+export VAISW_RUNSESSION_ENABLECORES=B0
+
+if [ $# -eq 1 ]; then
+    export VAISW_SNAPSHOT_TIMESTAMP=$1
+    snap_dir=VAISW.snapshot.$1${tiny:+.}$tiny
+else
+    snap_dir=VAISW.snapshot${tiny:+.}$tiny
+fi
+
+# first make sure quantisation is ready, if not, it will be done here
+./run sample_img/sample_dog.jpg ${tiny:+--}$tiny --out_file /dev/null || exit 1
+
+export VAISW_SNAPSHOT_DIRECTORY=$snap_dir
+
+VAISW_SNAPSHOT_MODE=embedded ./run sample_img/sample_dog.jpg ${tiny:+--}$tiny --out_file /dev/null || exit 1
