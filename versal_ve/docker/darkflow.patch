+  [ "$1" = "--tiny" ] && network="yolov2-tiny" && shift && continue
+  args="$args $1"
+  shift
+done
+
+python3 ./flow --pbLoad built_graph/$network.pb --metaLoad built_graph/$network.meta --threshold 0.5 --demo "$in" $args || exit 1
+
+[ "$out_file" != "" ] && mv video.avi $out_file
+
+exit 0
