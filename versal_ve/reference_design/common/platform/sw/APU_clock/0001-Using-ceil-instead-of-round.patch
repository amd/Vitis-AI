From 606a0497db79d27535206e3782ca99d43aaec7fb Mon Sep 17 00:00:00 2001
From: Raju Kumar Pothuraju <rajukumar.pothuraju@amd.com>
Date: Tue, 13 Aug 2024 14:23:45 +0530
Subject: [DTG][PATCH] Using ceil instead of round

---
 device_tree/data/device_tree.tcl | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/device_tree/data/device_tree.tcl b/device_tree/data/device_tree.tcl
index a2bd969..0912e88 100644
--- a/device_tree/data/device_tree.tcl
+++ b/device_tree/data/device_tree.tcl
@@ -532,7 +532,7 @@ proc gen_opp_freq {} {
 					set clkoutdiv [dict get $ps_pmc_params PS_CRF_APLL_CTRL_CLKOUTDIV]
 				}
 				if {[llength $act_freq] && [llength $div] && [llength $clkoutdiv]} {
-					set opp_freq [expr round([expr ($act_freq * $div) / $clkoutdiv]) * 1000000]
+					set opp_freq [expr ceil([expr ($act_freq * $div) / $clkoutdiv]) * 1000000]
 				}
 				# if design don't have clock configs then skip adding new opps
 				if {$opp_freq == ""} {
@@ -573,7 +573,7 @@ proc gen_opp_freq {} {
 					set clkoutdiv [dict get $psx_pmcx_params PSX_CRF_APLL1_CTRL_CLKOUTDIV]
 				}
 				if {[llength $act_freq] && [llength $div] && [llength $clkoutdiv]} {
-					set opp_freq [expr round([expr ($act_freq * $div) / $clkoutdiv]) * 1000000]
+					set opp_freq [expr ceil([expr ($act_freq * $div) / $clkoutdiv]) * 1000000]
 				}
 			}
 			# if design don't have clock configs then skip adding new opps
-- 
2.34.1

