{
    "passes": [
        {
            "name": "init",
            "plugin": "vaip-pass_init"
        },
        {
            "name": "vaiml_partition",
            "plugin": "vaip-pass_vaiml_partition",
            "vaiml_config": {
                "keep_outputs": true,
                "device": "ve2",
                "optimize_level": 4,
                "backend_args": "flatten-hierarchical-concat=true",
                "aiecompiler_args": "--x86sim-as-shared-library=false --compile-for-x86sim=true",
                "fe_experiment": "match-siluopt=1 tsg-config=tsg_config.json",
                "logging_level": "info",
                "threshold_gops_percent": 20,
                "dp_size": 4,
                "tp_size": 2,
                "skip_in_bo_sync": true,
                "skip_out_bo_sync": true,
                "analyzer_profiling": false,
                "visualization": false
            }
        }
    ],
    "target": "VAIML",
    "targets": [
        {
            "name": "VAIML",
            "pass": [
                "init",
                "vaiml_partition"
            ]
        }
    ]
}