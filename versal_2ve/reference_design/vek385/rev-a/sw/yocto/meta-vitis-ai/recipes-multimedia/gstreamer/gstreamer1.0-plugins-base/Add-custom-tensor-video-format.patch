+/* RGB_FLOAT */
+#define PACK_RGB_FLOAT GST_VIDEO_FORMAT_ARGB64, unpack_RGB_FLOAT, 1, pack_RGB_FLOAT
+static void
+unpack_RGB_FLOAT (const GstVideoFormatInfo * info, GstVideoPackFlags flags,
+    gpointer dest, const gpointer data[GST_VIDEO_MAX_PLANES],
+    const gint stride[GST_VIDEO_MAX_PLANES], gint x, gint y, gint width)
+{
+  int i;
+  const guint8 *restrict s = GET_LINE (y);
+  guint16 *restrict d = dest;
+  s += x * 12;
+  for (i = 0; i < width; i++) {
+    guint32 b0 = GST_READ_UINT32_LE (s + i * 12 + 0);
+    guint32 b1 = GST_READ_UINT32_LE (s + i * 12 + 4);
+    guint32 b2 = GST_READ_UINT32_LE (s + i * 12 + 8);
+    gfloat f0, f1, f2;
+    memcpy (&f0, &b0, sizeof (f0));
+    memcpy (&f1, &b1, sizeof (f1));
+    memcpy (&f2, &b2, sizeof (f2));
+    d[i * 4 + 0] = 0xFFFF;
+    d[i * 4 + 1] = (guint16) CLAMP (f0 * 65535.0f + 0.5f, 0.0f, 65535.0f);
+    d[i * 4 + 2] = (guint16) CLAMP (f1 * 65535.0f + 0.5f, 0.0f, 65535.0f);
+    d[i * 4 + 3] = (guint16) CLAMP (f2 * 65535.0f + 0.5f, 0.0f, 65535.0f);
+  }
+}
