+static gboolean
+gst_v4l2_buffer_pool_configure_tile_offset (GstV4l2BufferPool * pool,
+    GstBuffer * buffer)
+{
+  GstV4l2Object *obj = pool->obj;
+  struct v4l2_queryctrl query = { 0, };
+  struct v4l2_control control = { 0, };
+  GstVideoMeta *vmeta = NULL;
+  GstMemory *mem = NULL;
+  gsize memory_offset = 0;
+  gsize offset = 0;
+  const gchar *source = "full-frame layout";
+
+  pool->tile_offset_configured = FALSE;
+  pool->tile_control_available = FALSE;
+  pool->tile_offset = 0;
+
+  if (V4L2_TYPE_IS_OUTPUT (obj->type))
+    return TRUE;
+
+  if (obj->mode == GST_V4L2_IO_DMABUF_IMPORT && buffer) {
+    if (gst_buffer_n_memory (buffer) > 0) {
+      mem = gst_buffer_peek_memory (buffer, 0);
+      gst_memory_get_sizes (mem, &memory_offset, NULL);
+    }
+    vmeta = gst_buffer_get_video_meta (buffer);
+    if (vmeta && vmeta->n_planes > 0) {
+      offset = vmeta->offset[0];
+      source = "downstream VideoMeta";
+    }
+  }
+
+  query.id = V4L2_CID_XILINX_TILE_OFFSET;
+  if (obj->ioctl (pool->video_fd, VIDIOC_QUERYCTRL, &query) < 0) {
+    if (offset == 0) {
+      GST_DEBUG_OBJECT (pool,
+          "driver does not advertise the Xilinx tile destination offset "
+          "control");
+      return TRUE;
+    }
+    goto control_unavailable;
+  }
+  pool->tile_control_available = TRUE;
+
+  if ((query.flags & V4L2_CTRL_FLAG_DISABLED) && offset != 0)
+    goto control_disabled;
+  if (query.flags & V4L2_CTRL_FLAG_DISABLED)
+    return TRUE;
+
+  if (offset != 0) {
+    if (!buffer || gst_buffer_n_memory (buffer) != 1)
+      goto invalid_memory_count;
+    if (!vmeta || vmeta->n_planes != 1)
+      goto missing_video_meta;
+    if (memory_offset != 0)
+      goto nonzero_memory_offset;
+  }
+
+  if (offset > G_MAXINT32 || (gint64) offset < (gint64) query.minimum ||
+      (gint64) offset > (gint64) query.maximum)
+    goto offset_out_of_range;
+
+  control.id = V4L2_CID_XILINX_TILE_OFFSET;
+  control.value = (gint32) offset;
+  if (obj->ioctl (pool->video_fd, VIDIOC_S_CTRL, &control) < 0)
+    goto set_control_failed;
+
+  pool->tile_offset = offset;
+  pool->tile_offset_configured = TRUE;
+  GST_INFO_OBJECT (pool,
+      "set capture destination tile offset to %" G_GSIZE_FORMAT
+      " from %s", offset, source);
+
+  return TRUE;
+
+invalid_memory_count:
+  {
+    GST_ERROR_OBJECT (pool,
+        "automatic tile placement requires exactly one GstMemory");
+    return FALSE;
+  }
+missing_video_meta:
+  {
+    GST_ERROR_OBJECT (pool,
+        "automatic tile placement requires single-plane VideoMeta");
+    return FALSE;
+  }
+nonzero_memory_offset:
+  {
+    GST_ERROR_OBJECT (pool,
+        "VideoMeta tile layout requires GstMemory offset zero, got %"
+        G_GSIZE_FORMAT, memory_offset);
+    return FALSE;
+  }
+control_unavailable:
+  {
+    GST_ERROR_OBJECT (pool,
+        "driver has no tile destination control for nonzero offset %"
+        G_GSIZE_FORMAT, offset);
+    return FALSE;
+  }
+control_disabled:
+  {
+    GST_ERROR_OBJECT (pool,
+        "Xilinx tile destination offset control is disabled");
+    return FALSE;
+  }
+offset_out_of_range:
+  {
+    GST_ERROR_OBJECT (pool,
+        "tile offset %" G_GSIZE_FORMAT " is outside control range %d..%d",
+        offset, query.minimum, query.maximum);
+    return FALSE;
+  }
+set_control_failed:
+  {
+    GST_ERROR_OBJECT (pool,
+        "failed to set capture destination tile offset %" G_GSIZE_FORMAT
+        ": %s", offset, g_strerror (errno));
+    return FALSE;
+  }
+}
+
+static gboolean
+gst_v4l2_buffer_pool_reset_tile_offset (GstV4l2BufferPool * pool)
+{
+  struct v4l2_control control = { 0, };
+
+  if (!pool->tile_offset_configured) {
+    pool->tile_offset = 0;
+    return TRUE;
+  }
+
+  if (!pool->tile_control_available) {
+    pool->tile_offset_configured = FALSE;
+    pool->tile_offset = 0;
+    return TRUE;
+  }
+
+  control.id = V4L2_CID_XILINX_TILE_OFFSET;
+  control.value = 0;
+  if (pool->obj->ioctl (pool->video_fd, VIDIOC_S_CTRL, &control) < 0) {
+    GST_WARNING_OBJECT (pool,
+        "failed to reset capture destination tile offset: %s",
+        g_strerror (errno));
+    return FALSE;
+  }
+
+  GST_DEBUG_OBJECT (pool, "reset capture destination tile offset to zero");
+  pool->tile_offset_configured = FALSE;
+  pool->tile_offset = 0;
+  return TRUE;
 }

